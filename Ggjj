-- Logic ตัวแปร
local selectedPlayer = nil
local isHugging = false
local connection = nil
local animTrack = nil

local function updatePlayerList()
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, -6, 0, 30)
            pBtn.BackgroundColor3 = Color3.fromRGB(45, 38, 55)
            pBtn.BorderSizePixel = 0
            pBtn.Text = "  👤 " .. player.Name
            pBtn.TextColor3 = Color3.fromRGB(245, 245, 255)
            pBtn.TextSize = 11
            pBtn.Font = Enum.Font.Gotham
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.Parent = ScrollingFrame

            local pCorner = Instance.new("UICorner")
            pCorner.CornerRadius = UDim.new(0, 8)
            pCorner.Parent = pBtn

            pBtn.MouseButton1Click:Connect(function()
                selectedPlayer = player
                SelectedLabel.Text = "💖 เลือก: " .. player.Name
            end)
        end
    end
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 5)
end

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)
updatePlayerList()

-- ปุ่มกอด: เริ่มวาร์ปและเปิดสิทธิ์ให้ลากหน้าจอ GUI ได้
HugBtn.MouseButton1Click:Connect(function()
    if not selectedPlayer then return end
    isHugging = true

    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
            pcall(function()
                local anim = Instance.new("Animation")
                anim.AnimationId = "rbxassetid://139846829336719" -- ท่ากอด
                animTrack = animator:LoadAnimation(anim)
                animTrack:Play()
                animTrack.Looped = true
            end)
        end
    end

    if connection then connection:Disconnect() end
    connection = RunService.Heartbeat:Connect(function()
        if not isHugging or not selectedPlayer or not selectedPlayer.Character or not selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
            return
        end
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local targetHRP = selectedPlayer.Character.HumanoidRootPart
            myChar.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 0.8)
        end
    end)
end)

-- ปุ่มยกเลิก
DeselectBtn.MouseButton1Click:Connect(function()
    isHugging = false
    selectedPlayer = nil
    SelectedLabel.Text = "💖 เลือก: ยังไม่ได้เลือก"
    if connection then
        connection:Disconnect()
        connection = nil
    end
    if animTrack then
        pcall(function() animTrack:Stop() end)
        animTrack = nil
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    if rainbowConn then rainbowConn:Disconnect() end
    if connection then connection:Disconnect() end
    if animTrack then pcall(function() animTrack:Stop() end) end
    ScreenGui:Destroy()
end)

